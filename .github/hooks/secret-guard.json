{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/security/Test-SecretPatterns.ps1 -Mode Hook",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/security/Test-SecretPatterns.ps1 -Mode Hook",
        "linux": "pwsh -NoProfile -File scripts/security/Test-SecretPatterns.ps1 -Mode Hook",
        "osx": "pwsh -NoProfile -File scripts/security/Test-SecretPatterns.ps1 -Mode Hook",
        "timeout": 10
      }
    ]
  }
}